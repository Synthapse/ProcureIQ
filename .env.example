# Neo4j Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# DigitalOcean Gradient (OpenAI-compatible)
DO_GRADIENT_API_KEY=your_do_gradient_api_key
DO_GRADIENT_BASE_URL=https://inference.do-ai.run/v1
DO_GRADIENT_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# App Settings
APP_ENV=development
LOG_LEVEL=INFO
