# Neo4j Connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# LLM: priority OPENAI_API_KEY > DO_INFERENCE_ACCESS_KEY > DO_GRADIENT_API_KEY
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# DigitalOcean Inference (inference.do-ai.run) – direct LLM, e.g. openai-gpt-4o-mini
DO_INFERENCE_ACCESS_KEY=
DO_INFERENCE_BASE_URL=https://inference.do-ai.run/v1
DO_INFERENCE_MODEL=openai-gpt-4o-mini

# DigitalOcean Gradient (alternative LLM)
DO_GRADIENT_API_KEY=
DO_GRADIENT_BASE_URL=https://inference.do-ai.run/v1
DO_GRADIENT_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Knowledge Base RAG: kbaas retrieve or v2 API – both use DO_API_TOKEN (Bearer, GenAI:read scope)
DO_KB_RETRIEVE_URL=https://kbaas.do-ai.run/v1/YOUR_KB_UUID/retrieve
DO_API_TOKEN=
DO_KB_UUID=your_knowledge_base_uuid

# DigitalOcean hosted agent + Knowledge Base (from Gen AI / Agents in DO)
# Create an access key in the agent's Settings → Endpoint Access Keys
DO_AGENT_URL=https://aov4auhdhbx5tde55vczbcpc.agents.do-ai.run
DO_AGENT_ACCESS_KEY=your_agent_access_key

# App Settings
APP_ENV=development
LOG_LEVEL=INFO
